*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf

# Preserve archived evidence bytes: CSV CRLF and patch context-marker spaces.
experiments/robotwin/**/*.csv -text whitespace=cr-at-eol
experiments/robotwin/**/*.patch -text whitespace=-blank-at-eol,-blank-at-eof
scripts/robotwin/*.patch -text whitespace=-blank-at-eol,-blank-at-eof

# Preserve source-audit snapshots byte for byte for their SHA-256 manifests.
experiments/default_sfm/coordinate_audit/source_snapshot/** -text whitespace=-blank-at-eol,-blank-at-eof
experiments/default_sfm/preprocessing_audit/csilab_source_snapshot/** -text whitespace=-blank-at-eol,-blank-at-eof
experiments/default_sfm/preprocessing_audit/turbovla_training_source_snapshot/** -text whitespace=-blank-at-eol,-blank-at-eof
experiments/default_sfm/preprocessing_audit/turbovla_usb_source_snapshot/** -text whitespace=-blank-at-eol,-blank-at-eof
